NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3102
# Production browser API URL must match NEXT_PUBLIC_SITE_URL behind TLS proxy.
# NEXT_PUBLIC_* variables are baked into the Next.js build.
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://127.0.0.1:3100
NEXT_PUBLIC_FORMS_ENABLED=false
NEXT_PUBLIC_PRIVACY_APPROVED=false
PUBLIC_CONTENT_APPROVED=false

# Internal API host for Next.js server-side staff BFF and published content.
API_INTERNAL_URL=http://127.0.0.1:3100
# Enable only after connected CMS and content approvals are signed off.
CMS_PUBLIC_CONTENT_ENABLED=false

# Runtime-only server gates for nonfinancial member application UI.
MEMBER_PORTAL_ENABLED=false
MEMBER_APPLICATIONS_ENABLED=false
MEMBER_TERMS_VERSION=
MEMBER_PRIVACY_VERSION=
MEMBER_RECOVERY_ENABLED=false
# Separate business/legal release approval; required before compensation can be enabled.
MEMBER_COMPENSATION_APPROVED=false

DONATION_ACCOUNTING_ENABLED=false
