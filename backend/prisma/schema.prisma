generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

enum EnquiryCategory {
  CONTACT
  VOLUNTEER
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  ACCEPTED
  DECLINED
  WITHDRAWN
  CLOSED
}

model Enquiry {
  id String @id @db.Char(36)
  reference String @unique @db.VarChar(40)
  category EnquiryCategory
  name String @db.VarChar(120)
  email String @db.VarChar(254)
  phone String? @db.VarChar(20)
  subject String @db.VarChar(160)
  message String @db.Text
  interests String? @db.VarChar(300)
  availability String? @db.VarChar(300)
  consentAt DateTime @db.DateTime(3)
  privacyVersion String @db.VarChar(30)
  status EnquiryStatus @default(NEW)
  assignedToId String? @db.Char(36)
  assignedTo StaffUser? @relation("EnquiryAssignee",fields:[assignedToId],references:[id],onDelete:Restrict)
  caseRevision Int @default(0)
  archivedAt DateTime? @db.DateTime(3)
  legalHoldAt DateTime? @db.DateTime(3)
  anonymizedAt DateTime? @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)
  notes EnquiryNote[]
  createdAt DateTime @default(now()) @db.DateTime(3)

  @@index([category,createdAt])
  @@index([status,createdAt])
  @@map("enquiries")
}

enum StaffRole {
  ADMIN
}

enum StaffStatus {
  ACTIVE
  DISABLED
}

enum CmsKind {
  PAGE
  ACTIVITY
  PROJECT
  NEWS
  EVENT
  FAQ
}

enum EventLifecycle {
  SCHEDULED
  POSTPONED
  CANCELLED
  COMPLETED
}

enum CmsReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model StaffUser {
  id String @id @db.Char(36)
  email String @unique @db.VarChar(191)
  displayName String @db.VarChar(120)
  passwordHash String @db.VarChar(255)
  role StaffRole
  status StaffStatus @default(ACTIVE)
  failedLogins Int @default(0)
  lockedUntil DateTime? @db.DateTime(3)
  lastLoginAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  sessions StaffSession[]
  revisions CmsRevision[] @relation("RevisionAuthor")
  reviews CmsRevision[] @relation("RevisionReviewer")
  auditEntries CmsAudit[]
  assignedEnquiries Enquiry[] @relation("EnquiryAssignee")
  enquiryNotes EnquiryNote[] @relation("EnquiryNoteAuthor")
  uploadedMedia CmsMedia[] @relation("MediaUploader")
  reviewedMedia CmsMedia[] @relation("MediaReviewer")
  membershipReviews MembershipApplication[] @relation("MembershipReviewer")
  issuedMemberRecoveries MemberPasswordRecovery[] @relation("RecoveryIssuer")
  assistedMembershipApplications MembershipApplication[] @relation("MemberRegistrar")
  uatSignupPinBatches UatSignupPinBatch[] @relation("UatSignupIssuer")
  registrationPinBatches RegistrationPinBatch[] @relation("RegistrationPinIssuer")
  registrationPinsCancelled RegistrationPin[] @relation("RegistrationPinCanceller")
  registrationPinRefundsRecorded RegistrationPinRefund[] @relation("RegistrationPinRefundOperator")
  sandboxPoliciesAuthored SandboxPolicyRevision[] @relation("SandboxPolicyAuthor")
  sandboxPoliciesReviewed SandboxPolicyRevision[] @relation("SandboxPolicyReviewer")
  scenarioEntriesRecorded UatScenarioEntry[] @relation("UatScenarioActor")
  donationReceipts DonationReceipt[] @relation("DonationRecorder")
  donationEvents DonationEvent[] @relation("DonationEventActor")
  donationRefunds DonationRefund[] @relation("DonationRefundOperator")
  donationRefundEvents DonationRefundEvent[] @relation("DonationRefundEventActor")
  confirmedMemberSales MemberOfflineSale[] @relation("MemberSaleConfirmer")
  settledMemberEarnings MemberEarning[] @relation("MemberEarningSettler")
  decidedMemberPayouts MemberPayoutRequest[] @relation("MemberPayoutDecider")
  @@map("staff_users")
}

model StaffSession {
  id String @id @db.Char(36)
  staffId String @db.Char(36)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  staff StaffUser @relation(fields:[staffId],references:[id],onDelete:Restrict)
  @@index([staffId,expiresAt])
  @@map("staff_sessions")
}

model CmsContent {
  id String @id @db.Char(36)
  slug String @unique @db.VarChar(150)
  kind CmsKind
  publishedRevisionId String? @db.Char(36)
  archivedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  revisions CmsRevision[]
  @@index([kind,archivedAt])
  @@map("cms_content")
}

model CmsRevision {
  id String @id @db.Char(36)
  contentId String @db.Char(36)
  version Int
  title String @db.VarChar(200)
  summary String @db.VarChar(600)
  body String @db.Text
  eventStartAt DateTime? @db.DateTime(3)
  eventEndAt DateTime? @db.DateTime(3)
  eventTimezone String? @db.VarChar(80)
  eventVenue String? @db.VarChar(250)
  eventOnlineUrl String? @db.VarChar(2048)
  eventRegistrationUrl String? @db.VarChar(2048)
  eventLifecycle EventLifecycle?
  status CmsReviewStatus @default(DRAFT)
  authorId String @db.Char(36)
  reviewerId String? @db.Char(36)
  reviewReason String? @db.VarChar(1000)
  publishedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  content CmsContent @relation(fields:[contentId],references:[id],onDelete:Restrict)
  author StaffUser @relation("RevisionAuthor",fields:[authorId],references:[id],onDelete:Restrict)
  reviewer StaffUser? @relation("RevisionReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  @@unique([contentId,version])
  @@index([contentId,status])
  @@map("cms_revisions")
}

model CmsAudit {
  id String @id @db.Char(36)
  actorId String @db.Char(36)
  action String @db.VarChar(90)
  objectType String @db.VarChar(90)
  objectId String @db.VarChar(150)
  summary String @db.VarChar(500)
  createdAt DateTime @default(now()) @db.DateTime(3)
  actor StaffUser @relation(fields:[actorId],references:[id],onDelete:Restrict)
  @@index([objectType,objectId,createdAt])
  @@index([actorId,createdAt])
  @@map("cms_audit")
}

model EnquiryNote {
  id String @id @db.Char(36)
  enquiryId String @db.Char(36)
  authorId String @db.Char(36)
  body String @db.Text
  createdAt DateTime @default(now()) @db.DateTime(3)
  enquiry Enquiry @relation(fields:[enquiryId],references:[id],onDelete:Restrict)
  author StaffUser @relation("EnquiryNoteAuthor",fields:[authorId],references:[id],onDelete:Restrict)
  @@index([enquiryId,createdAt])
  @@map("enquiry_notes")
}

enum MediaReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

// Local filesystem owns image bytes. MySQL owns approval, rights and identity.
// Store only generated file keys; user-supplied filenames are never paths.
model CmsMedia {
  id String @id @db.Char(36)
  fileKey String @unique @db.VarChar(90)
  sha256 String @db.Char(64)
  mimeType String @default("image/webp") @db.VarChar(40)
  bytes Int
  width Int
  height Int
  title String @db.VarChar(160)
  altText String @db.VarChar(300)
  caption String? @db.VarChar(500)
  rightsConfirmed Boolean
  consentConfirmed Boolean
  rightsEvidenceRef String? @db.VarChar(120)
  consentEvidenceRef String? @db.VarChar(120)
  status MediaReviewStatus @default(DRAFT)
  uploaderId String @db.Char(36)
  reviewerId String? @db.Char(36)
  reviewReason String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.DateTime(3)
  reviewedAt DateTime? @db.DateTime(3)
  uploader StaffUser @relation("MediaUploader",fields:[uploaderId],references:[id],onDelete:Restrict)
  reviewer StaffUser? @relation("MediaReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  @@index([status,createdAt])
  @@map("cms_media")
}

enum MemberAccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  WITHDRAWN
}

enum MemberRegistrationSource {
  PUBLIC
  STAFF_ASSISTED
}

// FR-029..031: no payment, E-PIN, referral or matrix fields.
model MemberAccount {
  id String @id @db.Char(36)
  email String @unique @db.VarChar(191)
  // Nullable for pre-migration accounts; immediate registrations require it.
  mobile String? @unique @db.VarChar(16)
  displayName String @db.VarChar(120)
  passwordHash String @db.VarChar(255)
  status MemberAccountStatus @default(PENDING)
  communicationOptIn Boolean @default(false)
  referralCode String? @unique @db.VarChar(22)
  failedLogins Int @default(0)
  lockedUntil DateTime? @db.DateTime(3)
  lastLoginAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  application MembershipApplication?
  sessions MemberSession[]
  auditEvents MemberAudit[]
  passwordRecoveries MemberPasswordRecovery[]
  invitedMembers MemberInvitation[] @relation("MemberInviter")
  invitedBy MemberInvitation? @relation("MemberInvitee")
  redeemedUatPin UatSignupPin? @relation("UatPinConsumer")
  redeemedRegistrationPin RegistrationPin? @relation("RegistrationPinConsumer")
  scenarioEntriesSource UatScenarioEntry[] @relation("UatScenarioSource")
  scenarioEntriesBeneficiary UatScenarioEntry[] @relation("UatScenarioBeneficiary")
  matrixPositions MatrixPosition[]
  offlineSale MemberOfflineSale?
  earnings MemberEarning[] @relation("MemberEarningBeneficiary")
  earningSources MemberEarning[] @relation("MemberEarningSourceMember")
  payoutRequests MemberPayoutRequest[]
  payoutProfile MemberPayoutProfile?
  @@map("member_accounts")
}

model MemberSession {
  id String @id @db.Char(36)
  memberId String @db.Char(36)
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
  @@index([memberId,expiresAt])
  @@map("member_sessions")
}

model MembershipApplication {
  id String @id @db.Char(36)
  memberId String @unique @db.Char(36)
  status MembershipApplicationStatus @default(SUBMITTED)
  termsVersion String @db.VarChar(50)
  privacyVersion String @db.VarChar(50)
  consentAt DateTime @db.DateTime(3)
  registrationSource MemberRegistrationSource @default(PUBLIC)
  registeredByStaffId String? @db.Char(36)
  consentEvidenceRef String? @db.VarChar(120)
  reviewerId String? @db.Char(36)
  reviewedAt DateTime? @db.DateTime(3)
  decisionReason String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
  reviewer StaffUser? @relation("MembershipReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  registeredByStaff StaffUser? @relation("MemberRegistrar",fields:[registeredByStaffId],references:[id],onDelete:Restrict)
  @@index([status,createdAt])
  @@index([registeredByStaffId,createdAt])
  @@map("membership_applications")
}

model MemberAudit {
  id String @id @db.Char(36)
  memberId String @db.Char(36)
  action String @db.VarChar(60)
  createdAt DateTime @default(now()) @db.DateTime(3)
  member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
  @@index([memberId,createdAt])
  @@map("member_audit")
}

/**
 * Staff-verified recovery only: one-time bearer is returned to the issuing
 * ADMIN exactly once, after independent identity proof has been checked.
 * Never persist or audit the plaintext recovery code.
 */
model MemberPasswordRecovery {
  id String @id @db.Char(36)
  memberId String @db.Char(36)
  issuerId String @db.Char(36)
  tokenHash String @unique @db.Char(64)
  identityEvidenceRef String @db.VarChar(120)
  expiresAt DateTime @db.DateTime(3)
  usedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
  issuer StaffUser @relation("RecoveryIssuer",fields:[issuerId],references:[id],onDelete:Restrict)
  @@index([memberId,expiresAt])
  @@map("member_password_recoveries")
}

/**
 * Nonfinancial, nonproduction synthetic E-PIN UAT inventory.
 * These records cannot represent payment, paid registration or earnings.
 * No production code path may issue or redeem these credentials.
 */
model UatSignupPinBatch {
  id String @id @db.Char(36)
  requestKey String @unique @db.Char(36)
  issuerId String @db.Char(36)
  quantity Int
  expiresAt DateTime @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  issuer StaffUser @relation("UatSignupIssuer",fields:[issuerId],references:[id],onDelete:Restrict)
  pins UatSignupPin[]
  @@index([issuerId,createdAt])
  @@map("uat_signup_pin_batches")
}

model UatSignupPin {
  id String @id @db.Char(36)
  batchId String @db.Char(36)
  tokenHash String @unique @db.Char(64)
  displaySuffix String @db.Char(6)
  sealedCode String? @db.VarChar(255)
  expiresAt DateTime @db.DateTime(3)
  redeemedAt DateTime? @db.DateTime(3)
  redeemedByMemberId String? @unique @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  batch UatSignupPinBatch @relation(fields:[batchId],references:[id],onDelete:Restrict)
  redeemedBy MemberAccount? @relation("UatPinConsumer",fields:[redeemedByMemberId],references:[id],onDelete:Restrict)
  @@index([expiresAt,redeemedAt])
  @@map("uat_signup_pins")
}

/** Nonfinancial single-level attribution. Never awards or accrues commission. */
model MemberInvitation {
  id String @id @db.Char(36)
  inviterId String @db.Char(36)
  inviteeId String @unique @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  inviter MemberAccount @relation("MemberInviter",fields:[inviterId],references:[id],onDelete:Restrict)
  invitee MemberAccount @relation("MemberInvitee",fields:[inviteeId],references:[id],onDelete:Restrict)
  @@index([inviterId,createdAt])
  @@map("member_invitations")
}

/** Persistent nonfinancial 1:3 placement. No wallet, commission or payout fields. */
model MatrixState {
  id Int @id @db.TinyInt
  nextSequence Int
  @@map("matrix_state")
}
enum MatrixPositionKind {
  ORIGINAL
  REBIRTH
}
model MatrixPosition {
  id String @id @db.Char(36)
  sequence Int @unique
  entryKey String @unique @db.VarChar(120)
  memberId String @db.Char(36)
  parentId String? @db.Char(36)
  slot Int @db.TinyInt
  kind MatrixPositionKind @default(ORIGINAL)
  sourcePositionId String? @db.Char(36)
  triggerLevel Int? @db.TinyInt
  rebirthOrdinal Int? @db.TinyInt
  // A suspended owner permanently forfeited the level-4 rebirth of this position.
  level4RebirthSkippedAt DateTime? @db.DateTime(3)
  completedAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
  parent MatrixPosition? @relation("MatrixPositionParent",fields:[parentId],references:[id],onDelete:Restrict)
  children MatrixPosition[] @relation("MatrixPositionParent")
  sourcePosition MatrixPosition? @relation("MatrixRebirthSource",fields:[sourcePositionId],references:[id],onDelete:Restrict)
  rebirthPositions MatrixPosition[] @relation("MatrixRebirthSource")
  earnings MemberEarning[] @relation("MemberEarningSourcePosition")
  @@unique([parentId,slot])
  @@index([memberId,createdAt])
  @@index([parentId,sequence])
  @@index([sourcePositionId,triggerLevel])
  @@map("matrix_positions")
}

enum MemberEarningKind {
  DIRECT_REFERRAL
  MATRIX_LEVEL_1
  MATRIX_LEVEL_2
  MATRIX_LEVEL_3
  MATRIX_LEVEL_4
  MATRIX_LEVEL_5
}
enum MemberEarningStatus {
  EARNED
  SETTLED
}
model MemberOfflineSale {
  id String @id @db.Char(36)
  memberId String @unique @db.Char(36)
  registrationPinId String @unique @db.Char(36)
  requestKey String @unique @db.Char(36)
  reference String @unique @db.VarChar(80)
  amountPaise Int
  receivedAt DateTime @db.DateTime(3)
  evidenceRef String @db.VarChar(120)
  confirmedById String @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
  registrationPin RegistrationPin @relation(fields:[registrationPinId],references:[id],onDelete:Restrict)
  confirmer StaffUser @relation("MemberSaleConfirmer",fields:[confirmedById],references:[id],onDelete:Restrict)
  @@index([confirmedById,createdAt])
  @@map("member_offline_sales")
}
model MemberEarning {
  id String @id @db.Char(36)
  earningKey String @unique @db.VarChar(120)
  kind MemberEarningKind
  level Int? @db.TinyInt
  beneficiaryMemberId String @db.Char(36)
  sourceMemberId String? @db.Char(36)
  sourcePositionId String? @db.Char(36)
  amountPaise Int
  status MemberEarningStatus @default(EARNED)
  createdAt DateTime @default(now()) @db.DateTime(3)
  settlementRequestKey String? @unique @db.Char(36)
  settlementReference String? @unique @db.VarChar(80)
  settlementEvidenceRef String? @db.VarChar(120)
  settledAt DateTime? @db.DateTime(3)
  settledById String? @db.Char(36)
  beneficiary MemberAccount @relation("MemberEarningBeneficiary",fields:[beneficiaryMemberId],references:[id],onDelete:Restrict)
  sourceMember MemberAccount? @relation("MemberEarningSourceMember",fields:[sourceMemberId],references:[id],onDelete:Restrict)
  sourcePosition MatrixPosition? @relation("MemberEarningSourcePosition",fields:[sourcePositionId],references:[id],onDelete:Restrict)
  settledBy StaffUser? @relation("MemberEarningSettler",fields:[settledById],references:[id],onDelete:Restrict)
  @@index([beneficiaryMemberId,status,createdAt])
  @@index([sourceMemberId,createdAt])
  @@index([sourcePositionId,createdAt])
  @@map("member_earnings")
}


/** One member-level reserved payout request; financial source of truth stays MemberEarning. */
enum MemberPayoutStatus {
 REQUESTED
 PAID
 REJECTED
}
enum MemberPayoutMethod {
 BANK
 UPI
}
model MemberPayoutProfile {
 memberId String @id @db.Char(36)
 bankCiphertext String? @db.VarChar(1024)
 upiCiphertext String? @db.VarChar(1024)
 bankMask String? @db.VarChar(50)
 upiMask String? @db.VarChar(50)
 defaultMethod MemberPayoutMethod?
 updatedAt DateTime @updatedAt @db.DateTime(3)
 member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
 @@map("member_payout_profiles")
}
model MemberPayoutRequest {
 id String @id @db.Char(36)
 memberId String @db.Char(36)
 requestKey String @unique @db.Char(36)
 amountPaise Int
 payoutMethod MemberPayoutMethod?
 destinationCiphertext String? @db.VarChar(1024)
 destinationMask String? @db.VarChar(50)
 status MemberPayoutStatus @default(REQUESTED)
 createdAt DateTime @default(now()) @db.DateTime(3)
 decisionRequestKey String? @unique @db.Char(36)
 decidedAt DateTime? @db.DateTime(3)
 decidedById String? @db.Char(36)
 rejectionReason String? @db.VarChar(500)
 settlementReference String? @unique @db.VarChar(80)
 settlementEvidenceRef String? @db.VarChar(120)
 paidAt DateTime? @db.DateTime(3)
 member MemberAccount @relation(fields:[memberId],references:[id],onDelete:Restrict)
 decidedBy StaffUser? @relation("MemberPayoutDecider",fields:[decidedById],references:[id],onDelete:Restrict)
 @@index([memberId,status,createdAt])
 @@index([status,createdAt])
 @@map("member_payout_requests")
}
enum FinancialSettlementKind {
 EARNING
 PAYOUT
 PIN_REFUND
}
/** Cross-route unique external reference registry for legacy settlement + wallet payouts. */
model FinancialSettlementReference {
 reference String @id @db.VarChar(80)
 sourceId String @unique @db.Char(36)
 sourceKind FinancialSettlementKind
 createdAt DateTime @default(now()) @db.DateTime(3)
 @@map("financial_settlement_references")
}

// Internal scenario drafts, NOT live payout/placement policies.
// A REVIEWED scenario has no activation/effectiveAt path by design.
enum SandboxPolicyReviewStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  REJECTED
}

model SandboxPolicyRevision {
  id Int @id @default(autoincrement())
  requestKey String @unique @db.Char(36)
  entrants Int
  rebirthAtLevel4 Int
  rebirthAtLevel5 Int
  rebirthLimit Int
  rebirthEnabled Boolean
  status SandboxPolicyReviewStatus @default(DRAFT)
  authorId String @db.Char(36)
  reviewerId String? @db.Char(36)
  reason String? @db.VarChar(300)
  createdAt DateTime @default(now()) @db.DateTime(3)
  submittedAt DateTime? @db.DateTime(3)
  reviewedAt DateTime? @db.DateTime(3)
  author StaffUser @relation("SandboxPolicyAuthor",fields:[authorId],references:[id],onDelete:Restrict)
  reviewer StaffUser? @relation("SandboxPolicyReviewer",fields:[reviewerId],references:[id],onDelete:Restrict)
  @@index([status,createdAt])
  @@map("sandbox_policy_revisions")
}

/**
 * No-fee, Admin-created access codes for submitting a membership application.
 * Not purchased E-PINs, payment instruments, membership activation or rewards.
 * Separate from disposable UAT inventory; no UAT token is accepted here.
 */
model RegistrationPinBatch {
  id String @id @db.Char(36)
  requestKey String @unique @db.Char(36)
  issuerId String @db.Char(36)
  quantity Int
  expiresAt DateTime? @db.DateTime(3)
  createdAt DateTime @default(now()) @db.DateTime(3)
  issuer StaffUser @relation("RegistrationPinIssuer",fields:[issuerId],references:[id],onDelete:Restrict)
  pins RegistrationPin[]
  @@index([issuerId,createdAt])
  @@map("registration_pin_batches")
}

model RegistrationPin {
  id String @id @db.Char(36)
  batchId String @db.Char(36)
  tokenHash String @unique @db.Char(64)
  displaySuffix String @db.Char(6)
  sealedCode String? @db.VarChar(255)
  expiresAt DateTime? @db.DateTime(3)
  redeemedAt DateTime? @db.DateTime(3)
  redeemedByMemberId String? @unique @db.Char(36)
  cancelledAt DateTime? @db.DateTime(3)
  cancelledById String? @db.Char(36)
  cancellationReason String? @db.VarChar(500)
  cancelRequestKey String? @unique @db.Char(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  batch RegistrationPinBatch @relation(fields:[batchId],references:[id],onDelete:Restrict)
  redeemedBy MemberAccount? @relation("RegistrationPinConsumer",fields:[redeemedByMemberId],references:[id],onDelete:Restrict)
  cancelledBy StaffUser? @relation("RegistrationPinCanceller",fields:[cancelledById],references:[id],onDelete:Restrict)
  refund RegistrationPinRefund?
  offlineSale MemberOfflineSale?
  @@index([expiresAt,redeemedAt])
  @@map("registration_pins")
}
/** Admin evidence for a completed external refund. Cancellation by itself is not a refund. */
model RegistrationPinRefund {
 id String @id @db.Char(36)
 pinId String @unique @db.Char(36)
 requestKey String @unique @db.Char(36)
 bankReference String @unique @db.VarChar(80)
 evidenceRef String @db.VarChar(120)
 paidAt DateTime @db.DateTime(3)
 recordedAt DateTime @default(now()) @db.DateTime(3)
 recordedById String @db.Char(36)
 pin RegistrationPin @relation(fields:[pinId],references:[id],onDelete:Restrict)
 recordedBy StaffUser @relation("RegistrationPinRefundOperator",fields:[recordedById],references:[id],onDelete:Restrict)
 @@map("registration_pin_refunds")
}


// Strictly LOCAL UAT scenario records, NOT real payments or payable commissions.
// Entries model owner-confirmed flyer figures in isolated synthetic UAT only.
enum UatScenarioEntryKind {
 JOINING_REFERENCE
 DIRECT_REFERRAL_REFERENCE
}
model UatScenarioEntry {
 id String @id @db.Char(36)
 kind UatScenarioEntryKind
 sourceMemberId String @db.Char(36)
 beneficiaryMemberId String @db.Char(36)
 recordedByStaffId String @db.Char(36)
 requestKey String? @unique @db.Char(36)
 amountPaise Int
 source String @default("OWNER_CONFIRMED_FLYER") @db.VarChar(32)
 createdAt DateTime @default(now()) @db.DateTime(3)
 sourceMember MemberAccount @relation("UatScenarioSource",fields:[sourceMemberId],references:[id],onDelete:Restrict)
 beneficiary MemberAccount @relation("UatScenarioBeneficiary",fields:[beneficiaryMemberId],references:[id],onDelete:Restrict)
 actor StaffUser @relation("UatScenarioActor",fields:[recordedByStaffId],references:[id],onDelete:Restrict)
 @@unique([kind,sourceMemberId])
 @@index([beneficiaryMemberId,createdAt])
 @@map("uat_scenario_entries")
}

enum DonationStatus {
 PENDING
 RECONCILED
 REJECTED
}
enum DonationEventKind {
 RECORDED
 RECONCILED
 REJECTED
}
// Standalone donations only. Not enrollment, matrix, referral or payout.
model DonationReceipt {
 id String @id @db.Char(36)
 requestKey String @unique @db.Char(36)
 bankReference String @unique @db.VarChar(80)
 amountPaise Int
 receivedAt DateTime @db.DateTime(3)
 evidenceRef String @db.VarChar(120)
 status DonationStatus @default(PENDING)
 recordedById String @db.Char(36)
 createdAt DateTime @default(now()) @db.DateTime(3)
 updatedAt DateTime @updatedAt @db.DateTime(3)
 recorder StaffUser @relation("DonationRecorder",fields:[recordedById],references:[id],onDelete:Restrict)
 events DonationEvent[]
 refunds DonationRefund[]
 @@index([status,createdAt])
 @@map("donation_receipts")
}
model DonationEvent {
 id String @id @db.Char(36)
 requestKey String @unique @db.Char(36)
 receiptId String @db.Char(36)
 kind DonationEventKind
 actorId String @db.Char(36)
 evidenceRef String @db.VarChar(120)
 createdAt DateTime @default(now()) @db.DateTime(3)
 receipt DonationReceipt @relation(fields:[receiptId],references:[id],onDelete:Restrict)
 actor StaffUser @relation("DonationEventActor",fields:[actorId],references:[id],onDelete:Restrict)
 @@index([receiptId,createdAt])
 @@map("donation_events")
}


// Admin-attested outgoing refunds for stand-alone donations only.
enum DonationRefundStatus {
 PENDING
 CONFIRMED
 REJECTED
}
enum DonationRefundEventKind {
 REQUESTED
 CONFIRMED
 REJECTED
}
model DonationRefund {
 id String @id @db.Char(36)
 receiptId String @db.Char(36)
 requestKey String @unique @db.Char(36)
 bankReference String @unique @db.VarChar(80)
 amountPaise Int
 evidenceRef String @db.VarChar(120)
 status DonationRefundStatus @default(PENDING)
 createdById String @db.Char(36)
 reviewRequestKey String? @unique @db.Char(36)
 reviewEvidenceRef String? @db.VarChar(120)
 reviewedAt DateTime? @db.DateTime(3)
 createdAt DateTime @default(now()) @db.DateTime(3)
 receipt DonationReceipt @relation(fields:[receiptId],references:[id],onDelete:Restrict)
 operator StaffUser @relation("DonationRefundOperator",fields:[createdById],references:[id],onDelete:Restrict)
 events DonationRefundEvent[]
 @@index([receiptId,status])
 @@index([status,createdAt])
 @@map("donation_refunds")
}
model DonationRefundEvent {
 id String @id @db.Char(36)
 requestKey String @unique @db.Char(36)
 refundId String @db.Char(36)
 kind DonationRefundEventKind
 actorId String @db.Char(36)
 evidenceRef String @db.VarChar(120)
 createdAt DateTime @default(now()) @db.DateTime(3)
 refund DonationRefund @relation(fields:[refundId],references:[id],onDelete:Restrict)
 actor StaffUser @relation("DonationRefundEventActor",fields:[actorId],references:[id],onDelete:Restrict)
 @@index([refundId,createdAt])
 @@map("donation_refund_events")
}
