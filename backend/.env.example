PORT=3100
DATABASE_URL=mysql://nisvartha_app:replace-me@127.0.0.1:3306/nisvartha
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3102
FORM_SUBMISSIONS_ENABLED=false
PRIVACY_NOTICE_APPROVED=false
PRIVACY_NOTICE_VERSION=

# P1 staff accounts are provisioned only via authorized bootstrap; never public registration.
# NISVARTHA_BOOTSTRAP_EMAIL and NISVARTHA_BOOTSTRAP_NAME for first trusted-host bootstrap.

# Local-only, persistent, non-public project media volume; ABSOLUTE path. Never git-track.
MEDIA_STORAGE_ROOT=/srv/nisvartha/shared/media
# Local ClamAV is mandatory for production uploads. Missing scanner denies upload.
MEDIA_SCANNER_BIN=clamscan

# Nonfinancial member application feature (disabled until privacy/terms and account identity process approved).
MEMBER_PORTAL_ENABLED=false
MEMBER_APPLICATIONS_ENABLED=false
MEMBER_TERMS_VERSION=
MEMBER_PRIVACY_VERSION=
MEMBER_RECOVERY_ENABLED=false
